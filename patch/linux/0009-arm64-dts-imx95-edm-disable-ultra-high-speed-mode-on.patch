From 02f393fd26ee67af8bd44b03ddbf0e7a70109d1d Mon Sep 17 00:00:00 2001
From: Tifa Chen <tifa.chen@technexion.com>
Date: Thu, 22 Jan 2026 17:58:41 +0800
Subject: [PATCH] arm64: dts: imx95-edm: disable ultra high speed mode on mmc1

---
 arch/arm64/boot/dts/freescale/imx95-edm.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/freescale/imx95-edm.dtsi b/arch/arm64/boot/dts/freescale/imx95-edm.dtsi
index dc4969cd1b99..92135b8db139 100644
--- a/arch/arm64/boot/dts/freescale/imx95-edm.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx95-edm.dtsi
@@ -608,6 +608,7 @@ &usdhc2 {
 	pinctrl-3 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
 	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
 	vmmc-supply = <&reg_usdhc2_vmmc>;
+	no-1-8-v;
 	status = "okay";
 };
 
