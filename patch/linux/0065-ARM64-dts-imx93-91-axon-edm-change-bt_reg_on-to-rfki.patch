+		label = "bt_rfkill";
+		radio-type = "bluetooth";
+		shutdown-gpios = <&tca9554pwr 2 GPIO_ACTIVE_HIGH>;
 	};
 };
 
@@ -299,7 +298,6 @@ &lpuart5 {
 	assigned-clocks = <&clk IMX91_CLK_LPUART5>;
 	assigned-clock-parents = <&clk IMX91_CLK_24M>;
 	fsl,uart-has-rtscts;
-	resets = <&bt_reg_on>;
 	status = "okay";
 };
 
