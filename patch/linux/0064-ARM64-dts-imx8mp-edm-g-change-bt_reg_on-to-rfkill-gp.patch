From 68644d525d16cb4fae83820cd751a099d25f2938 Mon Sep 17 00:00:00 2001
From: Ray Chang <ray.chang@technexion.com>
Date: Wed, 13 Aug 2025 16:32:14 +0800
Subject: [PATCH 2/3] ARM64: dts: imx8mp-edm-g: change bt_reg_on to rfkill-gpio

---
 arch/arm64/boot/dts/freescale/imx8mp-edm-g.dtsi | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-edm-g.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-edm-g.dtsi
index eb9fd962f3b4..1919a16039d0 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-edm-g.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-edm-g.dtsi
@@ -58,14 +58,13 @@ wl_reg_on: wlreg_on {
 		enable-active-high;
 	};
 
-	bt_reg_on: btreg_on {
-		compatible = "gpio-reset";
+	rfkill {
+		compatible = "rfkill-gpio";
 		pinctrl-names = "default";
 		pinctrl-0 = <&pinctrl_bt_ctrl>;
-		reset-gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
-		reset-delay-us = <2000>;
-		reset-post-delay-ms = <200>;
-		#reset-cells = <0>;
+		label = "bt_rfkill";
+		radio-type = "bluetooth";
+		shutdown-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
 	};
 
 	sound-hdmi {
@@ -439,7 +438,6 @@ &uart1 {
 	assigned-clocks = <&clk IMX8MP_CLK_UART1>;
 	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
 	fsl,uart-has-rtscts;
-	resets = <&bt_reg_on>;
 	status = "okay";
 };
 
-- 
